<Project Sdk="Microsoft.NET.Sdk">

  <!-- dotnet build -c Release         -> MelonLoader  (bin/Release/InFalsusTextureSwap.dll)
         dotnet build -c BepInExRelease  -> BepInEx 6 IL2CPP (bin/BepInExRelease/InFalsusTextureSwap.dll)
       参考 DLL 从游戏安装目录取：优先 -p:GameDir，其次环境变量 INFALSUS_GAME_DIR。 -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>InFalsusTextureSwap</RootNamespace>
    <AssemblyName>InFalsusTextureSwap</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>Debug;Release;BepInExDebug;BepInExRelease</Configurations>
  </PropertyGroup>

  <!-- 游戏安装目录要在 LoaderDir 之前求出来。 -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">$(INFALSUS_GAME_DIR)</GameDir>
  </PropertyGroup>

  <!-- 哪个配置出哪个加载器；入口文件按 Loader 排除，不用预处理符号。 -->
  <PropertyGroup>
    <Loader Condition="'$(Configuration)' == 'BepInExDebug' Or '$(Configuration)' == 'BepInExRelease'">BepInEx</Loader>
    <Loader Condition="'$(Loader)' == ''">MelonLoader</Loader>
    <LoaderDir Condition="'$(Loader)' == 'MelonLoader'">$(GameDir)\MelonLoader</LoaderDir>
    <LoaderDir Condition="'$(Loader)' == 'BepInEx'">$(GameDir)\BepInEx</LoaderDir>
  </PropertyGroup>

  <!-- SDK 默认会加这六个程序集属性，没人读，去掉少六个 TypeRef。 -->
  <PropertyGroup>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'BepInExRelease'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'BepInExRelease'">
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'BepInExDebug'">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">$(INFALSUS_GAME_DIR)</GameDir>
  </PropertyGroup>

  <Target Name="RequireGameDir" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(GameDir)' == ''"
           Text="没给游戏安装目录。用 dotnet build -c Release -p:GameDir=&quot;游戏安装目录&quot;，或先设环境变量 INFALSUS_GAME_DIR。" />
  </Target>

  <ItemGroup>
    <Compile Include="Source\**\*.cs" />
    <Compile Remove="Source\Mod\Entry.BepInEx.cs" Condition="'$(Loader)' != 'BepInEx'" />
    <Compile Remove="Source\Mod\Entry.Melon.cs" Condition="'$(Loader)' == 'BepInEx'" />
  </ItemGroup>

  <!-- MelonLoader 的参考程序集。 -->
  <ItemGroup Condition="'$(Loader)' == 'MelonLoader'">
    <Reference Include="MelonLoader">
      <HintPath>$(LoaderDir)\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(LoaderDir)\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(LoaderDir)\net6\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(LoaderDir)\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(LoaderDir)\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- BepInEx 6 IL2CPP 的参考程序集。 -->
  <ItemGroup Condition="'$(Loader)' == 'BepInEx'">
    <Reference Include="BepInEx.Core">
      <HintPath>$(LoaderDir)\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(LoaderDir)\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(LoaderDir)\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(LoaderDir)\core\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(LoaderDir)\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(LoaderDir)\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
